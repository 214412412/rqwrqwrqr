.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.logo {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-text {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.logo-subtitle {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 8rpx;
  margin-top: 16rpx;
  display: block;
}

.menu {
  width: 100%;
  max-width: 500rpx;
}

.menu-item {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.menu-item:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.3);
}

.menu-item.primary {
  background: rgba(255, 255, 255, 0.95);
}

.menu-item.primary .menu-text {
  color: #667eea;
}

.menu-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.menu-text {
  font-size: 36rpx;
  color: #fff;
  font-weight: 500;
}

.difficulty-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx;
  width: 80%;
  max-width: 500rpx;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
  display: block;
}

.difficulty-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.difficulty-item {
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.difficulty-item:active {
  background: #667eea;
}

.difficulty-item:active .difficulty-name,
.difficulty-item:active .difficulty-desc {
  color: #fff;
}

.difficulty-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.difficulty-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}