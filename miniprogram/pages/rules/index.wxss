.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.rules-content {
  padding: 20rpx;
}

.rule-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

.section-content {
  padding-left: 16rpx;
}

.rule-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.rule-item:last-child {
  margin-bottom: 0;
}

.rule-number {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  min-width: 48rpx;
  text-align: center;
}

.rule-text {
  font-size: 30rpx;
  color: #666;
  line-height: 1.6;
  flex: 1;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.1);
}

.footer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #667eea;
  border-radius: 16rpx;
}

.footer-btn-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.footer-btn-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}