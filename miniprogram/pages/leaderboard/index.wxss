.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
}

.tabs {
  display: flex;
  padding: 20rpx;
  gap: 16rpx;
  background: #fff;
  margin: -20rpx 20rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab text {
  font-size: 28rpx;
  color: #999;
}

.tab.active {
  background: #667eea;
}

.tab.active text {
  color: #fff;
  font-weight: bold;
}

.leaderboard-list {
  padding: 0 20rpx;
}

.leaderboard-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.rank {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.rank-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #999;
}

.rank-num:first-child {
  color: #FFD700;
  font-size: 40rpx;
}

.rank-num:nth-child(2) {
  color: #C0C0C0;
  font-size: 40rpx;
}

.rank-num:nth-child(3) {
  color: #CD7F32;
  font-size: 40rpx;
}

.score-info {
  flex: 1;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.score-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.difficulty-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #666;
}

.detail-row {
  display: flex;
  gap: 20rpx;
}

.time, .mistakes {
  font-size: 24rpx;
  color: #999;
}

.date {
  text-align: right;
}

.date text {
  font-size: 22rpx;
  color: #ccc;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: #667eea;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
}

.empty-btn text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.1);
}

.footer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #667eea;
  border-radius: 16rpx;
}

.footer-btn-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.footer-btn-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
}